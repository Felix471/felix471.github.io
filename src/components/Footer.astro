---
import { site } from '../data/site';
import LinksRow from './LinksRow.astro';

// Stamped at build time, so it reflects the last deploy.
const updated = new Date();
const updatedISO = updated.toISOString().slice(0, 10);
const updatedText = updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<footer class="footer">
  <div class="container footer__inner">
    <LinksRow label="Profiles and contact (footer)" size="small" />
    <p class="footer__meta">
      &copy; {updated.getUTCFullYear()} {site.name} &middot; Last updated{" "}
      <time datetime={updatedISO}>{updatedText}</time>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding-block: 2rem;
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .footer__meta {
    margin: 0;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  @media (min-width: 40rem) {
    .footer__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
