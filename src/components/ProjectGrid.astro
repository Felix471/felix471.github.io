---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const order = ['retrace', 'basis', 'ai-avalon'];
const projects = await getCollection('projects');
const featured = order.map((slug) => {
  const project = projects.find(({ data }) => data.slug === slug);
  if (!project) throw new Error(`Missing home project: ${slug}`);
  return project;
});
---

<section id="projects" aria-labelledby="projects-title">
  <h2 class="section-heading" id="projects-title">Projects</h2>
  {featured.map((project) => <ProjectCard project={project} />)}
</section>
