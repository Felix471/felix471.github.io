---
import { writing } from '../data/writing';

// Dated entries newest first; undated entries keep their file order and go last.
const entries = [...writing.entries].sort((a, b) => {
  if (a.date && b.date) return b.date.localeCompare(a.date);
  if (a.date) return -1;
  if (b.date) return 1;
  return 0;
});

function formatDate(iso: string) {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    timeZone: 'UTC',
  });
}
---

<section id="writing" class="section" aria-labelledby="writing-heading">
  <div class="container">
    <h2 id="writing-heading">Writing</h2>
    <p class="writing__intro prose">{writing.intro}</p>
    <ul class="writing__list">
      {
        entries.map((entry) => (
          <li class="writing__item">
            <div class="writing__title-row">
              <a href={entry.url} target="_blank" rel="noopener noreferrer" lang={entry.lang}>
                {entry.title}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
              {entry.lang === 'zh' && <span class="tag">zh</span>}
            </div>
            <p class="writing__description" lang={entry.lang}>
              {entry.description}
            </p>
            {entry.date && (
              <time class="writing__date" datetime={entry.date}>
                {formatDate(entry.date)}
              </time>
            )}
          </li>
        ))
      }
    </ul>
    <p class="writing__more">
      <a href={writing.profileUrl} target="_blank" rel="noopener noreferrer">
        More on Medium &rarr;<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </p>
  </div>
</section>

<style>
  .writing__intro {
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
    text-wrap: pretty;
  }
  .writing__list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--measure);
  }
  .writing__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.15rem 1.5rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--border);
  }
  .writing__item:last-child {
    border-bottom: 1px solid var(--border);
  }
  .writing__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
  }
  .writing__title-row a {
    color: var(--fg);
    text-decoration: none;
  }
  .writing__title-row a:hover {
    text-decoration: underline;
  }
  .writing__description {
    margin: 0;
    color: var(--fg-muted);
  }
  .writing__date {
    font-size: 0.875rem;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .writing__more {
    margin: 1.25rem 0 0;
    font-weight: 500;
  }
  @media (min-width: 40rem) {
    .writing__item {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'title date'
        'desc date';
    }
    .writing__title-row {
      grid-area: title;
    }
    .writing__description {
      grid-area: desc;
    }
    .writing__date {
      grid-area: date;
      align-self: start;
      padding-top: 0.2rem;
    }
  }
</style>
