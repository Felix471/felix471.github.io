---
/** Light/dark switch. Persists the choice in localStorage; falls back to the system preference. */
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  hidden
  aria-label="Toggle dark mode"
  aria-pressed="false"
  title="Toggle dark mode"
>
  <svg class="icon icon--sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"></path>
  </svg>
  <svg class="icon icon--moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    color: var(--ink-colour);
    background: transparent;
    cursor: pointer;
  }

  .theme-toggle[hidden], .icon--sun { display: none; }
  .theme-toggle:hover { background: var(--wash); }
  :global(:root[data-theme='dark']) .icon--sun { display: block; }
  :global(:root[data-theme='dark']) .icon--moon { display: none; }
</style>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function current(): 'light' | 'dark' {
    return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }

  function apply(theme: 'light' | 'dark') {
    root.setAttribute('data-theme', theme);
    button?.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
  }

  apply(current());
  if (button) button.hidden = false;

  function storedChoice(): boolean {
    try {
      const stored = localStorage.getItem('theme');
      return stored === 'light' || stored === 'dark';
    } catch {
      return false;
    }
  }

  // Remembered in memory too, so the choice holds when storage is unavailable.
  let chosen = storedChoice();

  button?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    apply(next);
    chosen = true;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // Follow the OS while the user has not made an explicit choice.
  media.addEventListener('change', (e) => {
    if (chosen) return;
    apply(e.matches ? 'dark' : 'light');
  });
</script>
