---
import { coverLinks, site } from '../data/site';
import FlyPicker from './FlyPicker.astro';
import LinksRow from './LinksRow.astro';
---

<div class="opening">
  <section class="cover" aria-labelledby="name">
    <h1 id="name">{site.name}</h1>
    <p class="role">{site.tagline}</p>
    <dl class="bio">
      <div>
        <dt>Languages</dt>
        <dd>English, Japanese, Chinese</dd>
      </div>
    </dl>
    <div class="cover-links">
      <LinksRow links={coverLinks} />
    </div>
  </section>
  <FlyPicker />
</div>
