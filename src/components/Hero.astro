---
import { site } from '../data/site';
import LinksRow from './LinksRow.astro';
---

<section class="hero section" aria-labelledby="hero-heading">
  <div class="container">
    <h1 id="hero-heading">{site.name}</h1>
    <p class="hero__tagline">{site.tagline}</p>
    <LinksRow label="Profiles and contact" />
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 12vw, 7rem);
  }
  .hero__tagline {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--fg-muted);
    max-width: var(--measure);
    margin-bottom: 1.75rem;
    text-wrap: pretty;
  }
</style>
