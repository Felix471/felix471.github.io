---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LinksRow from '../../components/LinksRow.astro';
import ProjectPlate from '../../components/ProjectPlate.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, links } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
  <article class="project-page">
    <p><a href="/#projects">Back to projects</a></p>
    <header>
      <h1 class="section-heading">{title}</h1>
      <p class="project-summary">{summary}</p>
      <LinksRow links={links} />
    </header>
    <ProjectPlate project={project.data} />
    <div class="prose"><Content /></div>
  </article>
</Base>
